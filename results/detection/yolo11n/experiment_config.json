{
    "model": "YOLO11n",
    "base_weights": "yolo11n.pt",
    "transfer_pipeline": "COCO pretrained -> PlantDoc -> PlantVillage",
    "plantdoc_dataset": "yusufmurtaza01/plantdoc-object-detection-dataset",
    "plantdoc_train_images": 2335,
    "plantdoc_validation_images": 236,
    "plantdoc_classes": 29,
    "plantvillage_samples": 52959,
    "plantvillage_train": 42363,
