    "plantdoc_epochs": 15,
    "plantvillage_epochs": 20,
    "optimizer": "AdamW",
    "lr0": 0.001,
    "weight_decay": 0.0005,
    "seed": 42,
    "ultralytics_version": "8.4.152",
    "torch_version": "2.11.0+cu128",
    "gpu": "Tesla T4"
}